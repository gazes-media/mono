generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Anime {
  id        Int      @id @default(autoincrement())
  titleFr   String?  @unique
  titleJp   String?
  titleEnJp String?
  titleEn   String?
  others    String[]

  nekoId  Int    @unique
  nekoUrl String @db.VarChar(2048)

  synopsis         String?   @db.Text
  Episodes         Episode[]
  episodesCount    Int       @default(0)
  nextEpisodeDate  DateTime?
  startDate        DateTime?
  endDate          DateTime?
  animeType        String
  status           String
  genres           String[]
  clearLogoTitle   String?   @db.VarChar(2048)
  background       String?   @db.VarChar(2048)
  banner           String?   @db.VarChar(2048)
  poster           String    @db.VarChar(2048)
  tags             String[]
  youtubeTrailerId String?

  prequel_id    Int?
  sequel_id     Int?
  relations_ids Int[]

  dataToFetch   DataToFetch? @relation(fields: [dataToFetchId], references: [id])
  dataToFetchId Int?         @unique
}

model DataToFetch {
  id        Int    @id @default(autoincrement())
  anime     Anime?
  kitsuId   Int?   @unique
  thetvdbId Int?   @unique
}

model Episode {
  id           Int      @id @default(autoincrement())
  time         Int
  title        String   @db.VarChar(2048)
  release_date DateTime
  synopsis     String   @db.Text
  num          Int
  url          String   @unique
  banner       String   @db.VarChar(2048)
  anime_id     Int
  Anime        Anime    @relation(fields: [anime_id], references: [id])
}
